{
    "fp16": {
        "enabled": false
    },
    "bf16": {
        "enabled": true
    },
    "checkpoint": {
        "use_node_local_storage": true
    },
    "zero_optimization": {
        "stage": 2,
        "allgather_partitions": true,
        "allgather_bucket_size": 1e9,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": "auto",
        "contiguous_gradients": false
    },
    "gradient_accumulation_steps": "auto",
    "gradient_clipping": 1,
    "steps_per_print": 10,
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": "auto",
    "wall_clock_breakdown": false,
    "flops_profiler": {
        "enabled": true,
        "profile_step": 1,
        "module_depth": -1,
        "top_modules": 1,
        "detailed": true,
        "output_file": "flops_profile"
    }
}